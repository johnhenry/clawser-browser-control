{
  "manifest_version": 3,
  "name": "Clawser Browser Control",
  "version": "0.2.0",
  "description": "Gives the Clawser agent real browser control: tabs, screenshots, DOM, input, monitoring.",

  "browser_specific_settings": {
    "gecko": {
      "id": "clawser@clawser.dev",
      "strict_min_version": "128.0"
    }
  },

  "permissions": [
    "tabs",
    "activeTab",
    "scripting",
    "userScripts",
    "webRequest",
    "cookies",
    "storage",
    "alarms",
    "contextMenus"
  ],
  "host_permissions": ["<all_urls>"],

  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },

  "background": {
    "scripts": ["background.js"]
  },

  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "file:///*",
        "https://clawser.erisera.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "web_accessible_resources": [
    {
      "resources": ["pod-inject.js"],
      "matches": [
        "http://localhost/*",
        "https://localhost/*",
        "http://127.0.0.1/*",
        "https://127.0.0.1/*",
        "file:///*",
        "https://clawser.erisera.com/*"
      ]
    }
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
